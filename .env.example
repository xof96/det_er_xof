# =====================================================================
# Personal Atlas — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env. No secret is ever
# exposed to the frontend — GitHub tokens and SMTP creds stay on the backend.
# =====================================================================

# ---------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------

# CORS: comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Database (defaults to a local SQLite file inside backend/).
# DATABASE_URL=sqlite:////absolute/path/to/atlas.db

# --- GitHub integration ---
# Optional. Public repos work without a token (lower rate limit). A token
# raises the limit. Curated repos are listed in content/github.json.
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_CACHE_TTL=3600

# --- Contact form ---
# Where contact messages are emailed to (optional). Without SMTP config,
# messages are still validated and stored in the database.
CONTACT_EMAIL=

# SMTP delivery (all optional — set together to enable email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Anti-spam tuning.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=3600
CONTACT_MIN_ELAPSED_MS=1200

# ---------------------------------------------------------------------
# Frontend (Vite) — variables must be prefixed with VITE_ to be exposed.
# ---------------------------------------------------------------------

# API base URL. In development the dev server proxies /api to the backend,
# so this can be left as /api. In production set it to your API origin, e.g.
# VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=/api

# Used only by the dev server proxy target (defaults to http://localhost:8000).
VITE_API_PROXY=http://localhost:8000
