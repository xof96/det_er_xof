# Normalise line endings: keep LF in the repo on every platform so switching
# between Linux and Windows produces no spurious diffs.
* text=auto eol=lf

# Explicitly text (LF).
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
*.sh    text eol=lf
.env.example text eol=lf

# Binary assets — never touch these.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.mp4   binary
*.webm  binary
